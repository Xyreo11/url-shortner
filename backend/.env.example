# Copy to .env and fill in. Every variable the application reads is listed here.
#
# JWT_SECRET and IP_SALT were previously read by the code but documented
# nowhere, so following the README produced an app that threw on first login
# and hashed visitor IPs with a hardcoded fallback salt. Both are now required:
# with NODE_ENV=production the app refuses to start if either is missing.
#
# The database name here was also wrong (urlshortener); the schema and the
# recovered dump both use shortifydb.

NODE_ENV=development
APP_NAME=shortify
PORT=3000
BASE_URL=http://localhost:3000

# --- Postgres ---------------------------------------------------------------
# Use the service name `postgres` when the app runs inside compose, and
# localhost:5433 when it runs on the host against the compose stack.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shortifydb
POSTGRES_URL=postgres://postgres:postgres@postgres:5432/shortifydb

# Connection pool. This is the ceiling on concurrent queries, so it is worth
# setting deliberately rather than inheriting the driver default of 10.
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=5000

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# --- Auth -------------------------------------------------------------------
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# bcrypt cost factor. Higher is slower by design. Must be held constant across
# any before/after performance comparison or login timings are meaningless.
BCRYPT_ROUNDS=12

# --- Analytics privacy ------------------------------------------------------
# Salts visitor IPs before hashing so the raw address is never stored.
# Generate the same way as JWT_SECRET.
IP_SALT=

# --- Rate limiting ----------------------------------------------------------
# Link creation, per IP. Configurable so a load test can raise it identically
# across benchmark phases instead of measuring rate-limit rejections.
RATE_LIMIT_CREATE_MAX=10
RATE_LIMIT_CREATE_WINDOW_S=60

# --- Security ---------------------------------------------------------------
# Comma-separated CORS allowlist. Never use "*" together with credentials.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Only enable behind a reverse proxy you control. When on, X-Forwarded-For is
# believed, and that header decides both the rate-limit bucket and the
# analytics IP hash, so trusting it from arbitrary clients lets them choose both.
TRUST_PROXY=false

# How long a blacklist verdict stays cached, in seconds.
BLACKLIST_TTL_S=600

# Auth attempts per IP. Both auth routes run bcrypt, so leaving them
# unthrottled is a cheap CPU denial of service as well as free credential
# stuffing.
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_S=300

# Where winston writes rotating log files. Point this outside any synced
# folder (OneDrive, Dropbox) when benchmarking, or the sync client interferes
# with the measurement.
LOG_DIR=logs
