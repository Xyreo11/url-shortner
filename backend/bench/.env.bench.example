# Copy to bench/.env.bench (gitignored) and adjust.
#
# These point at the compose stack from the HOST, not from inside a container.
# The application under test runs natively during a benchmark: the compose app
# service bind-mounts the Windows filesystem and routes through the WSL2 NAT,
# both of which add noise that has nothing to do with the code being measured.
# Postgres and Redis stay in Docker, which is realistic since the app reaches
# them over a socket either way.

BENCH_POSTGRES_URL=postgres://postgres:postgres@localhost:5433/shortifydb
BENCH_REDIS_URL=redis://localhost:6379
BENCH_BASE_URL=http://localhost:3000

# --- Data set ---------------------------------------------------------------
# Codes run b0000001 .. b<SEED_URLS>. The first HOT_URLS are warmed into
# Redis; everything above is the cold pool used by the cache-miss scenario and
# is deliberately never warmed.
BENCH_SEED_URLS=50000
BENCH_HOT_URLS=10000
BENCH_SEED_ANALYTICS=500000
BENCH_SEED_USERS=10
BENCH_USER_PASSWORD=benchpassword1

# Must equal the app's BCRYPT_ROUNDS for the run, or seeded hashes verify at a
# different cost than the app expects. Held constant across both phases, or
# the login comparison is meaningless.
BENCH_BCRYPT_ROUNDS=10

# --- Load shape -------------------------------------------------------------
# Offered arrival rate in requests per second, split across the weighted mix.
# Pick a rate the SLOWER build can sustain, so the fixed-rate comparison is
# latency at equal load rather than one build saturating.
BENCH_RATE=200

# Warmup is excluded from the reported numbers via the phase tag.
BENCH_WARMUP_S=30
BENCH_DURATION_S=180
