# The exact application configuration for a benchmark run. Committed on
# purpose: a measurement whose configuration is not recorded is not a
# measurement, and the first attempt at this benchmark was unreproducible
# precisely because the run used inline environment variables that existed
# nowhere in the repository.
#
# Sourced by bench/start-app.sh. Every value here must be IDENTICAL across the
# baseline and optimized phases, or the comparison is measuring configuration
# rather than code.
#
# The secrets below are throwaway values for a local load test against
# synthetic data. They are not used anywhere else and must never be reused.

NODE_ENV=production
APP_NAME=shortify

# The app's own .env says PORT=5000 while BASE_URL and the harness both say
# 3000. Pinned here so there is one answer.
PORT=3000
BASE_URL=http://localhost:3000

# Host-reachable. The app's .env points at the compose service hostname
# `postgres`, which cannot resolve for a natively running process.
POSTGRES_URL=postgres://postgres:postgres@localhost:5433/shortifydb
REDIS_URL=redis://localhost:6379

JWT_SECRET=bench-only-not-a-real-secret
IP_SALT=bench-only-not-a-real-salt

# MUST equal BENCH_BCRYPT_ROUNDS in .env.bench. bcrypt.compare uses the cost
# embedded in the stored hash, so if the seeder writes cost 10 and the app
# thinks it is configured for 12, login latency is understated roughly 4x and
# the discrepancy is invisible in the results.
BCRYPT_ROUNDS=10

# The ceiling on concurrent queries, and therefore on redirect throughput
# while the click write is still synchronous. Stated rather than inherited.
PG_POOL_MAX=20

# libuv threadpool. Defaults to 4, and bcrypt, winston's file writes and zlib
# all contend for it. At 400 requests per second that contention is real and
# it must at least be constant across phases.
UV_THREADPOOL_SIZE=8

# Raised so the create scenario measures the write path instead of measuring
# HTTP 429. This override is disclosed in the results.
RATE_LIMIT_CREATE_MAX=1000000
RATE_LIMIT_CREATE_WINDOW_S=60
RATE_LIMIT_AUTH_MAX=1000000
RATE_LIMIT_AUTH_WINDOW_S=300

TRUST_PROXY=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LOG_DIR is set by start-app.sh to a path outside any synced folder. It is
# deliberately NOT set here, because the correct value depends on the machine
# and a wrong default is worse than none: this repository lives inside a
# OneDrive-synced tree, and a per-request file write there means the sync
# client interferes with the measurement.
